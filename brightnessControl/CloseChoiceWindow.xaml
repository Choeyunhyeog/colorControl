<Window x:Class="brightnessControl.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="닫기 동작 선택"
        Width="360"
        Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="창을 닫을 때 수행할 동작을 선택하세요."
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Width="86"
                    Margin="0,0,8,0"
                    Padding="8,6"
                    Click="MinimizeButton_Click"
                    Content="최소화" />
            <Button Width="86"
                    Margin="0,0,8,0"
                    Padding="8,6"
                    Click="ExitButton_Click"
                    Content="종료" />
            <Button Width="86"
                    Padding="8,6"
                    Click="CancelButton_Click"
                    Content="취소" />
        </StackPanel>
    </Grid>
</Window>
