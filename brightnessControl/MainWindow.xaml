<Window x:Class="brightnessControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brightness Control"
        Width="1280"
        Height="620"
        MinWidth="1260"
        MinHeight="520">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Game Color Profiles" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="ProfilePathText"
                           Margin="0,4,0,0"
                           Foreground="#666"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Margin="0,12,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="Monitor" />
                <ComboBox x:Name="DisplayTargetPicker"
                          Width="190"
                          Margin="0,0,12,8"
                          ItemsSource="{Binding DisplayTargetOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="DeviceName"
                          SelectionChanged="DisplayTargetPicker_SelectionChanged" />
                <Button x:Name="ScanGamesButton"
                        Width="96"
                        Margin="0,0,8,8"
                        Padding="8,6"
                        Click="ScanGamesButton_Click"
                        Content="Scan Games" />
                <ComboBox x:Name="GamePicker"
                          Width="260"
                          Margin="0,0,8,8"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="False" />
                <Button x:Name="AddSelectedGameButton"
                        Width="112"
                        Margin="0,0,8,8"
                        Padding="8,6"
                        Click="AddSelectedGameButton_Click"
                        Content="Add Profile"
                        IsEnabled="False" />
                <Button Width="86"
                        Margin="0,0,8,8"
                        Padding="8,6"
                        Click="RemoveButton_Click"
                        Content="Remove" />
                <Button Width="86"
                        Margin="0,0,8,8"
                        Padding="8,6"
                        Click="SaveButton_Click"
                        Content="Save" />
                <Button Width="110"
                        Margin="0,0,8,8"
                        Padding="8,6"
                        Click="ApplySelectedButton_Click"
                        Content="Apply Now" />
                <Button Width="150"
                        Margin="0,0,0,8"
                        Padding="8,6"
                        Click="RestoreButton_Click"
                        Content="Restore Original" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="ProfilesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Auto"
                      IsReadOnly="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enabled"
                                            Width="80"
                                            Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Game"
                                        Width="2*"
                                        Binding="{Binding GameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Process (.exe)"
                                        Width="2*"
                                        Binding="{Binding ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Brightness %"
                                        Width="110"
                                        Binding="{Binding ColorProfile.BrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <DataGridTextColumn Header="Contrast %"
                                        Width="105"
                                        Binding="{Binding ColorProfile.ContrastPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <DataGridTextColumn Header="Gamma"
                                        Width="85"
                                        Binding="{Binding ColorProfile.Gamma, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />
                    <DataGridTextColumn Header="Vibrance %"
                                        Width="105"
                                        Binding="{Binding ColorProfile.DigitalVibrancePercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <DataGridTextColumn Header="Hue"
                                        Width="80"
                                        Binding="{Binding ColorProfile.HueDegrees, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBox x:Name="LogTextBox"
                     Grid.Row="2"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
